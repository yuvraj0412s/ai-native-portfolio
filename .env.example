GITHUB_TOKEN=
MISTRAL_API_KEY=

# Optional: override the Mistral model (default: mistral-small-latest)
# MISTRAL_MODEL=mistral-small-latest

# Groq fallback — used only when Mistral is temporarily unavailable (429/5xx/etc.)
GROQ_API_KEY=
# Optional: override the Groq fallback model (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Spotify "now playing" widget
# 1. Create an app at https://developer.spotify.com/dashboard to get the client id/secret.
# 2. Authorize once with the `user-read-currently-playing` and `user-read-recently-played`
#    scopes, then exchange the auth code for a long-lived refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
